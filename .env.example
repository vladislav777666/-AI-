# Supabase → Project Settings → API
# Без этих значений приложение работает на mock-проверке пароля.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NVIDIA NIM — ИИ (подсказка шифра, выбор исполнителя, вердикт §3.2).
# Без ключа работают локальные эвристики src/lib/ai.ts.
VITE_NVIDIA_NIM_API_KEY=
VITE_NIM_MODEL=nvidia_nim/openai/gpt-oss-20b
VITE_ENABLE_THINKING=true
